# DABBOBA environment inventory
#
# This file contains placeholders only. Do not commit real credentials.
# The API, database CLI, and worker read process environment variables; they do
# not automatically load this file. Export the values through the local shell
# or the deployment secret manager. Next.js should receive its values through
# apps/admin/.env.local locally or through the hosting environment.

# Shared runtime mode: development | test | production
NODE_ENV=development
LOG_LEVEL=debug

# Local test login and its database-backed sample account are opt-in. Never set
# these on a public/shared deployment. Use `local` for the bundled local DB or
# the explicit Supabase project ref for a private developer database.
DABBOBA_ENABLE_DEV_SESSION=false
DABBOBA_ENABLE_MOBILE_TEST_FIXTURES=false
DABBOBA_MOBILE_TEST_FIXTURE_PROJECT_REF=

# Fastify API
API_HOST=127.0.0.1
API_PORT=8788
# production defaults to customer; local all keeps customer/admin route tests.
API_SURFACE=all

# Customer Vite app. This is a public API origin only; never add a bearer token
# to a VITE_ variable. Remove this line only when intentionally using fixture-
# backed prototype mode in development.
VITE_DABBOBA_API_URL=http://127.0.0.1:8788

# Exact, comma-separated origins. Production values must use HTTPS and must not
# contain paths, wildcards, or trailing route segments.
WEB_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
ADMIN_ORIGINS=http://127.0.0.1:4180,http://localhost:4180

# DABBOBA uses dedicated local ports so it can run beside other local projects.
# DATABASE_URL is the restricted API account. WORKER_DATABASE_URL is the
# separately provisioned worker account. DATABASE_MIGRATION_URL is the schema-
# owner account and must be exposed only to the migration job. Local Compose may
# use the same owner account for convenience; production requires three roles.
DATABASE_URL=postgresql://dabboba:dabboba_local@127.0.0.1:55433/dabboba
WORKER_DATABASE_URL=postgresql://dabboba:dabboba_local@127.0.0.1:55433/dabboba
DATABASE_MIGRATION_URL=postgresql://dabboba:dabboba_local@127.0.0.1:55433/dabboba
# Optional local shared rate-limit store. Leave unset on Cloud Run to avoid a
# separately billed Redis service; the API then uses an instance-local guard.
REDIS_URL=redis://127.0.0.1:56380
DATABASE_POOL_MAX=5

# Generate a unique high-entropy value in the deployment secret manager for
# every non-local environment. Rotating it invalidates every existing session.
SESSION_TOKEN_PEPPER=local-development-only-change-me
SESSION_TTL_DAYS=30

# Customer authentication broker. Fastify verifies Supabase access tokens from
# this exact issuer with its public JWKS, then issues the existing DABBOBA
# opaque session. Auth verification does not use a service-role/secret key;
# the separate Storage adapter below requires its own server-only credential.
# Leave unset during local UI work until the Supabase project and asymmetric
# JWT signing key exist. Production startup refuses to run without this URL.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Shared only by the Next admin BFF and Fastify API. Production requires a
# unique 32-512 byte value, distinct from SESSION_TOKEN_PEPPER. Keep it in the
# deployment secret manager. Local development may leave both values empty and
# the API will use the direct socket IP for the login limiter/audit trail.
ADMIN_PROXY_IDENTITY_SECRET=
# Exact single-IP header that the first trusted edge removes and overwrites on
# every request before it reaches Next.js (provider-specific; no comma chain).
ADMIN_EDGE_CLIENT_IP_HEADER=

# Separate Next.js administrator application. DABBOBA_API_URL is server-only.
# Keep NEXT_PUBLIC_DABBOBA_API_URL unset unless a deliberate browser-side API
# consumer is introduced and reviewed.
DABBOBA_API_URL=http://127.0.0.1:8788
NEXT_PUBLIC_DABBOBA_API_URL=
# Local cookie name. Production should use __Host-dabboba_admin_session.
ADMIN_SESSION_COOKIE_NAME=dabboba_admin_session

# One-time administrator bootstrap. Keep all values empty at rest. In
# production, ALLOW_ADMIN_BOOTSTRAP must be set to true only for the bootstrap
# command and removed immediately afterward.
ALLOW_ADMIN_BOOTSTRAP=false
DABBOBA_BOOTSTRAP_ADMIN_EMAIL=
DABBOBA_BOOTSTRAP_ADMIN_NICKNAME=
DABBOBA_BOOTSTRAP_ADMIN_PASSWORD=
DABBOBA_BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN

# Payment boundary. UNCONFIGURED means no real payment may be accepted. The
# selected provider adapter, sandbox/live keys, and webhook secret must be
# supplied outside the repository before payment testing or launch. In
# production the webhook secret must be a dedicated 32-512 byte value, distinct
# from SESSION_TOKEN_PEPPER and ADMIN_PROXY_IDENTITY_SECRET. Leave it empty when
# the provider is UNCONFIGURED; INTERNAL_ZERO is a reserved server-only rail.
PAYMENT_PROVIDER=UNCONFIGURED
PAYMENT_WEBHOOK_SECRET=

# New upload default: gcs preserves existing installations until the operator
# completes Supabase Storage conformance. Set supabase only after that check.
# Existing objects keep their recorded provider/bucket during rollout/rollback.
MEDIA_STORAGE_PROVIDER=gcs
# Server-only Secret Manager values, NEVER Expo/VITE/NEXT_PUBLIC variables.
# No bucket creation or plan change is performed by application startup.
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=
# Dedicated loopback test fixtures only; forbidden in production.
SUPABASE_STORAGE_ALLOW_LOCAL_HTTP=false

# Legacy Google Cloud Storage. Keep access until legacy objects are migrated.
# Production worker requires a configured GCS or Supabase Storage provider. Use
# Application Default Credentials in the deployment environment; for local-only
# development GOOGLE_APPLICATION_CREDENTIALS may point to a non-committed file.
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Finite Supabase Queues (pgmq) worker. It runs once and exits; Cloud Scheduler
# invokes the Cloud Run Job. DATABASE_MIGRATION_URL is never passed to it.
WORKER_QUEUE_NAME=dabboba_worker
WORKER_OUTBOX_BATCH_SIZE=50
WORKER_PAYMENT_STALE_MINUTES=10
WORKER_MEDIA_PENDING_TTL_MINUTES=5
WORKER_MEDIA_REJECTED_TTL_HOURS=24
WORKER_JOB_ATTEMPTS=8
WORKER_JOB_BACKOFF_MS=1000
# 900s = the 600s Cloud Run task timeout plus a 300s safety margin.
WORKER_QUEUE_VISIBILITY_SECONDS=900
WORKER_MAX_MESSAGES_PER_RUN=100
WORKER_MAX_RUN_SECONDS=45
# Each SQL operation must finish well inside the 60-second shutdown margin.
WORKER_DATABASE_OPERATION_TIMEOUT_MS=30000

# Development/test-only external notification adapter. Production rejects this
# URL until the receiver durably enforces same-key/same-payload idempotency and
# exposes auditable delivery receipts. In-app notification rows remain active.
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=

# Expo variables belong in apps/mobile/.env for local/standalone builds. The
# production primary URL and every additional allowed origin must use HTTPS.
EXPO_PUBLIC_DABBOBA_WEB_URL=
EXPO_PUBLIC_DABBOBA_ALLOWED_ORIGINS=

# Public Auth client values only. The publishable key is intentionally safe to
# bundle in the app; never put a Supabase secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
