{
  "name": "@dabboba/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:release": "tsx src/check-release.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "provision:runtime-role": "tsx src/provision-runtime-role.ts",
    "provision:worker-role": "tsx src/provision-worker-role.ts",
    "seed": "tsx src/seed.ts",
    "pretest": "node ../../scripts/check-test-backend-env.mjs",
    "test": "tsx --test 'src/*.test.ts'"
  },
  "dependencies": {
    "@dabboba/config": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  }
}
