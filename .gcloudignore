# Deny by default. These rules intentionally use gcloud's ignore syntax rather
# than including .dockerignore because the two tools handle directory
# re-inclusion differently. CI compares the effective upload list to the
# reviewed Docker build inputs.
**

!.dockerignore
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json

!patches/
!patches/node-forge@1.4.0.patch

!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/*.ts
!apps/api/src/lib/
!apps/api/src/lib/*.ts
!apps/api/src/modules/
!apps/api/src/modules/*.ts
!apps/api/src/plugins/
!apps/api/src/plugins/*.ts
!apps/worker/
!apps/worker/package.json
!apps/worker/tsconfig.json
!apps/worker/src/
!apps/worker/src/*.ts

!packages/
!packages/config/
!packages/config/package.json
!packages/config/tsconfig.json
!packages/config/src/
!packages/config/src/*.ts
!packages/contracts/
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/openapi/
!packages/contracts/openapi/*.yaml
!packages/contracts/src/
!packages/contracts/src/*.ts
!packages/db/
!packages/db/package.json
!packages/db/tsconfig.json
!packages/db/migrations/
!packages/db/migrations/*.sql
!packages/db/src/
!packages/db/src/index.ts
!packages/db/src/kuji-room.ts
!packages/db/src/migrate.ts
!packages/db/src/runtime-role.ts
!packages/db/src/supabase-root-ca.ts
!packages/domain/
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/
!packages/domain/src/*.ts
!packages/media-storage/
!packages/media-storage/package.json
!packages/media-storage/tsconfig.json
!packages/media-storage/src/
!packages/media-storage/src/*.ts

# Explicitly keep development and operator-only sources out even if an allow
# rule is broadened later.
**/*.test.ts
**/*.integration.test.ts
**/*.conformance.ts
**/*.test-d.ts
**/*.tsbuildinfo
packages/db/src/provision-runtime-role.ts
packages/db/src/provision-worker-role.ts
packages/db/src/role-credentials.ts
packages/db/src/role-provisioning.ts
packages/db/src/seed.ts
