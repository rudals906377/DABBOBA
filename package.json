{
  "name": "@dabboba/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.19 <12"
  },
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:storefront": "corepack pnpm --filter @dabboba/storefront build",
    "build:public-site": "corepack pnpm run build:storefront && node scripts/prepare-public-site-build.mjs",
    "predev": "corepack pnpm run check:runtime",
    "dev": "vite --host 0.0.0.0 --port 4174 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 4174 --strictPort",
    "dev:api": "node scripts/run-local-backend.mjs api",
    "dev:admin": "node scripts/run-local-backend.mjs admin",
    "dev:worker": "node scripts/run-local-backend.mjs worker",
    "predev:all": "corepack pnpm run workspace:assert && corepack pnpm run workspace:packages",
    "dev:all": "corepack pnpm --filter @dabboba/web --filter './apps/*' --parallel --if-present run dev",
    "local:services": "docker compose -p dabboba-local -f ops/local/compose.yaml up -d --wait",
    "local:services:stop": "docker compose -p dabboba-local -f ops/local/compose.yaml stop",
    "local:backend:prepare": "node scripts/prepare-local-backend.mjs --apply",
    "local:backend:check": "node scripts/prepare-local-backend.mjs --check",
    "db:migrate": "corepack pnpm --filter @dabboba/db migrate",
    "db:seed": "corepack pnpm --filter @dabboba/db seed",
    "db:release-source:check": "node scripts/check-database-release-source.mjs",
    "supabase:edge:prepare": "node scripts/prepare-supabase-edge-profile.mjs --prepare",
    "supabase:edge:deploy": "node scripts/deploy-supabase-edge.mjs",
    "supabase:edge:public:verify": "node scripts/verify-public-edge-surface.mjs",
    "supabase:edge:verify": "node scripts/verify-supabase-edge-runtime.mjs",
    "supabase:worker:provision": "node scripts/provision-supabase-worker-role.mjs",
    "supabase:worker:schedule": "node scripts/configure-supabase-worker-schedule.mjs",
    "catalog:photos:check": "node scripts/sync-product-photo-catalog.mjs --check",
    "catalog:photos:apply": "node scripts/sync-product-photo-catalog.mjs --apply",
    "workspace:assert": "node scripts/check-workspace-structure.mjs",
    "workspace:packages": "corepack pnpm --filter './packages/*' build",
    "mobile": "corepack pnpm --filter @dabboba/mobile start",
    "mobile:ios": "corepack pnpm --filter @dabboba/mobile ios",
    "mobile:auth:ios": "corepack pnpm --filter @dabboba/mobile auth:ios",
    "mobile:auth:android": "corepack pnpm --filter @dabboba/mobile auth:android",
    "release:mobile:check": "node scripts/check-mobile-release-config.mjs",
    "release:mobile:api:verify": "node scripts/verify-mobile-public-api.mjs",
    "release:mobile:bundle:check": "node scripts/check-mobile-production-bundle.mjs",
    "ios:local": "corepack pnpm mobile:ios",
    "mobile:android": "corepack pnpm --filter @dabboba/mobile android",
    "prebuild": "corepack pnpm run check:runtime",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs && corepack pnpm run build:public-site",
    "build:all": "turbo run build",
    "audit:prod": "corepack pnpm audit --prod --audit-level high",
    "pretest": "node scripts/check-test-backend-env.mjs",
    "test": "corepack pnpm run test:unit",
    "test:unit": "node --test tests/*.test.mjs && corepack pnpm --filter @dabboba/api exec tsx --test '../../tests/*.test.ts'",
    "test:integration:required": "node scripts/check-test-backend-env.mjs --require-integration-db && turbo run build && turbo run test --concurrency=1",
    "pretest:all": "node scripts/check-test-backend-env.mjs",
    "test:all": "corepack pnpm run workspace:assert && turbo run build && turbo run typecheck && turbo run test --concurrency=4 && corepack pnpm --filter @dabboba/storefront run test:browser && corepack pnpm run test:runtime && corepack pnpm run test:sites"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@karrotmarket/react-monochrome-icon": "^1.25.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@seed-design/css": "^2.5.0",
    "@seed-design/react": "^2.3.0",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "turbo": "^2.5.8",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "workspaces": [".", "apps/*", "packages/*"]
}
