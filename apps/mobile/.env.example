# Production builds require an HTTPS URL. HTTP is accepted only for localhost,
# private LAN addresses, and emulators while __DEV__ is true.
EXPO_PUBLIC_DABBOBA_WEB_URL=https://your-dabboba-web.example.com

# Optional exact origins that may stay inside the WebView. Use comma-separated
# bare origins with no path, query, wildcard, or credentials.
EXPO_PUBLIC_DABBOBA_ALLOWED_ORIGINS=https://auth.your-dabboba-web.example.com
