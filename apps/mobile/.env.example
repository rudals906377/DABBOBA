# Native app API. When omitted in development, the app derives the Metro host
# and uses port 8788. Production builds require an HTTPS URL.
EXPO_PUBLIC_DABBOBA_API_URL=https://api.your-dabboba.example.com

# Optional development/legacy asset origin for relative catalog image paths.
# Production catalog media should use absolute Supabase Storage/CDN URLs.
EXPO_PUBLIC_DABBOBA_ASSET_BASE_URL=https://assets.your-dabboba.example.com

# Legacy WebView compatibility only. Do not use this as the native app runtime.
EXPO_PUBLIC_DABBOBA_WEB_URL=https://your-dabboba-web.example.com

# Optional exact origins that may stay inside the WebView. Use comma-separated
# bare origins with no path, query, wildcard, or credentials.
EXPO_PUBLIC_DABBOBA_ALLOWED_ORIGINS=https://auth.your-dabboba-web.example.com
