# Native app API. When omitted in development, the app derives the Metro host
# and uses port 8788. Production builds require an HTTPS URL.
EXPO_PUBLIC_DABBOBA_API_URL=https://api.dabboba.com

# Optional development/legacy asset origin for relative catalog image paths.
# Production catalog media should use absolute Supabase Storage/CDN URLs.
EXPO_PUBLIC_DABBOBA_ASSET_BASE_URL=https://assets.your-dabboba.example.com

# Legacy WebView compatibility only. Do not use this as the native app runtime.
EXPO_PUBLIC_DABBOBA_WEB_URL=https://your-dabboba-web.example.com

# Optional exact origins that may stay inside the WebView. Use comma-separated
# bare origins with no path, query, wildcard, or credentials.
EXPO_PUBLIC_DABBOBA_ALLOWED_ORIGINS=https://auth.your-dabboba-web.example.com

# Supabase Auth broker. Only the public project URL and publishable (or legacy
# anon) key may be embedded in the customer app. Never use a secret/service-role
# key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public PortOne V2 identifiers for the KG INICIS channel. Internal/TestFlight
# and Play closed-test builds use the TEST channel; production uses LIVE.
EXPO_PUBLIC_PORTONE_STORE_ID=
EXPO_PUBLIC_PORTONE_CHANNEL_KEY=
# Fail-closed build switch. Use LIVE only for a payment-enabled reviewed build;
# omission and every other value keep purchase/draw controls disabled.
EXPO_PUBLIC_COMMERCE_CAPABILITY=PRELAUNCH

# EAS project UUID used to obtain this installation's Expo push token. Public
# project metadata only; APNs/FCM credentials and Expo access tokens stay server-side.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public HTTPS pages required by the store release gate. These must be working
# pages, not placeholders, before a production build is approved.
EXPO_PUBLIC_DABBOBA_PRIVACY_POLICY_URL=https://dabboba.com/privacy
EXPO_PUBLIC_DABBOBA_TERMS_URL=https://dabboba.com/terms
EXPO_PUBLIC_DABBOBA_SUPPORT_URL=https://dabboba.com/support
EXPO_PUBLIC_DABBOBA_ACCOUNT_DELETION_URL=https://dabboba.com/account-deletion
