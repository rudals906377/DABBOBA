{
  "name": "@dabboba/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare:workspace": "corepack pnpm --filter @dabboba/contracts build && corepack pnpm --filter @dabboba/api-client build",
    "prestart": "corepack pnpm run prepare:workspace",
    "start": "node ../../scripts/dabboba-mobile-launch.mjs",
    "preandroid": "corepack pnpm run prepare:workspace",
    "android": "node ../../scripts/dabboba-mobile-launch.mjs --android",
    "preios": "corepack pnpm run prepare:workspace",
    "ios": "node ../../scripts/dabboba-mobile-launch.mjs --ios",
    "test": "node --test ../../tests/expo-shell-structure.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dabboba/api-client": "workspace:*",
    "@dabboba/contracts": "workspace:*",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-kr": "0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-gl": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "galmuri": "2.40.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
