{
  "name": "@dabboba/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare:workspace": "corepack pnpm --filter @dabboba/contracts build && corepack pnpm --filter @dabboba/api-client build",
    "prestart": "corepack pnpm run prepare:workspace",
    "start": "expo start --go",
    "preandroid": "corepack pnpm run prepare:workspace",
    "android": "expo start --android --go",
    "preios": "corepack pnpm run prepare:workspace",
    "ios": "expo start --ios --go",
    "test": "node --test ../../tests/expo-shell-structure.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dabboba/api-client": "workspace:*",
    "@dabboba/contracts": "workspace:*",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-kr": "0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "7.18.17",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "galmuri": "2.40.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "metro": "0.83.8",
    "postcss": "8.5.26"
  }
}
