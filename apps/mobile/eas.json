{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "24.21.0",
      "corepack": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_COMMERCE_CAPABILITY": "PRELAUNCH"
      }
    },
    "pg-review": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_COMMERCE_CAPABILITY": "LIVE"
      }
    },
    "production-prelaunch": {
      "extends": "base",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_COMMERCE_CAPABILITY": "PRELAUNCH"
      }
    },
    "production-live": {
      "extends": "base",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_COMMERCE_CAPABILITY": "LIVE"
      }
    }
  },
  "submit": {
    "production-prelaunch": {},
    "production-live": {}
  }
}
