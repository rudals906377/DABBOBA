{
  "name": "@dabboba/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/run-local-backend.mjs worker",
    "build": "tsc -p tsconfig.json",
    "build:edge": "node ../../scripts/build-supabase-worker.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../../scripts/check-test-backend-env.mjs",
    "test": "tsx --test 'src/*.test.ts'"
  },
  "dependencies": {
    "@dabboba/config": "workspace:*",
    "@dabboba/db": "workspace:*",
    "@dabboba/media-storage": "workspace:*",
    "@google-cloud/storage": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
