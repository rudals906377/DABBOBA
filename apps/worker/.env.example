NODE_ENV=development
DABBOBA_ENVIRONMENT_TIER=LOCAL
DABBOBA_RELEASE_ENVIRONMENT_TIER=DEVELOPMENT
DABBOBA_LOCAL_BACKEND_PROFILE=local-development
WORKER_DATABASE_URL=postgresql://dabboba_worker:generated-local-worker-password@127.0.0.1:55433/dabboba_development
WORKER_QUEUE_NAME=dabboba_worker
WORKER_OUTBOX_BATCH_SIZE=50
WORKER_PAYMENT_STALE_MINUTES=10
# Claimed PortOne windows still READY/PAY_PENDING after this many minutes close as PENDING_EXPIRED (10-1440).
WORKER_PAYMENT_WINDOW_VALIDITY_MINUTES=30
WORKER_MEDIA_PENDING_TTL_MINUTES=5
WORKER_MEDIA_REJECTED_TTL_HOURS=24
WORKER_JOB_ATTEMPTS=8
WORKER_JOB_BACKOFF_MS=1000
# 900s = the 600s Cloud Run task timeout plus a 300s safety margin.
WORKER_QUEUE_VISIBILITY_SECONDS=900
WORKER_MAX_MESSAGES_PER_RUN=100
WORKER_MAX_RUN_SECONDS=45
DABBOBA_ENABLE_PRODUCTION_WORKER=false
WORKER_DATABASE_OPERATION_TIMEOUT_MS=30000
DATABASE_POOL_MAX=3
# Read-only reconciliation remains manual in LOCAL/TEST. Configure KG INICIS
# only as a complete STAGING+TEST or PRODUCTION+LIVE secret set.
PAYMENT_RECONCILIATION_PROVIDER=MANUAL_REVIEW
# Server-only Supabase Auth Admin credential for automatic account deletion.
# The worker deletes the external identity before local identity/PII cleanup.
# Hosted Supabase Edge Functions inject their managed service-role value.
SUPABASE_URL=
SUPABASE_AUTH_ADMIN_SECRET_KEY=
# Apple refresh-token revocation runs before Supabase Auth deletion. These four
# values are all-or-none and are stored only in deployment secrets.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_TOKEN_ENCRYPTION_KEY_VERSION=
# KG_INICIS_ENVIRONMENT=TEST
# KG_INICIS_MID=set-in-deployment-secret-configuration
# KG_INICIS_INIAPI_KEY=set-in-deployment-secret-configuration
# KG_INICIS_CLIENT_IP=set-to-the-configured-server-ipv4
GCS_BUCKET=
GCS_PROJECT_ID=
# Development/test only. Production rejects this adapter until the receiver
# provides durable same-key/same-payload idempotency and delivery receipts.
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=
# Server-only Expo access token. When absent, the worker keeps in-app
# notifications but intentionally does not attempt remote push delivery.
EXPO_PUSH_ACCESS_TOKEN=
LOG_LEVEL=debug
