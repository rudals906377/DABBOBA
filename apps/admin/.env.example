# Server-only API origin. Never prefix this value with NEXT_PUBLIC_.
DABBOBA_API_URL=http://127.0.0.1:8788

# Required together in production. The secret must match the Fastify API value
# and be a unique 32-512 byte secret. The named ingress header must be removed
# and overwritten by the trusted edge and contain exactly one IP literal.
ADMIN_PROXY_IDENTITY_SECRET=
ADMIN_EDGE_CLIENT_IP_HEADER=

# Keep the __Host- prefix in production: Secure, Path=/, and no Domain attribute.
ADMIN_SESSION_COOKIE_NAME=__Host-dabboba_admin_session

# Next.js runtime mode. Production requires an HTTPS API URL.
NODE_ENV=development
