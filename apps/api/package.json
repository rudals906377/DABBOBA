{
  "name": "@dabboba/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/run-local-backend.mjs api",
    "build": "tsc -p tsconfig.json",
    "build:supabase": "node ../../scripts/build-supabase-api.mjs",
    "build:supabase:admin": "node ../../scripts/build-supabase-api.mjs --admin",
    "build:supabase:integration": "node ../../scripts/build-supabase-api.mjs --integration-smoke",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../../scripts/check-test-backend-env.mjs",
    "test": "node --test --test-concurrency=1 'dist/**/*.test.js'",
    "test:storage": "tsx --test src/modules/media-supabase.conformance.ts",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@dabboba/config": "workspace:*",
    "@dabboba/contracts": "workspace:*",
    "@dabboba/db": "workspace:*",
    "@dabboba/domain": "workspace:*",
    "@dabboba/media-storage": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google-cloud/storage": "^8.0.1",
    "@portone/server-sdk": "0.19.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0"
  }
}
