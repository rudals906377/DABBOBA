{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DABBOBA_ENVIRONMENT_TIER",
    "DATABASE_MIGRATION_URL",
    "DABBOBA_TEST_DATABASE_URL",
    "DABBOBA_RUNTIME_TEST_DATABASE_URL",
    "DABBOBA_WORKER_TEST_DATABASE_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@dabboba/web#build": {
      "dependsOn": ["@dabboba/storefront#build", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  }
}
