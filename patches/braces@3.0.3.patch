 'use strict';
 
+const { MAX_DEPTH, MAX_LENGTH } = require('./constants');
+
+exports.checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Braces nesting depth exceeds local limit (${MAX_DEPTH})`);
+  }
+};
+
+// Complex values can recurse through implicit String/Number conversion even
+// when child depth is bounded. Preserve safe scalar coercion and parser NaN.
+exports.assertPrimitive = (value, name) => {
+  if (value !== null && (typeof value === 'object' || typeof value === 'function')) {
+    throw new TypeError(`${name} must be a primitive value`);
+  }
+};
+
+// Check caller-supplied ASTs without recursively visiting them. Only child
+// edges contribute to depth: parsed AST parent/prev backlinks are legitimate.
+// Count visits, not unique nodes, so a shared DAG cannot multiply walker work.
+exports.assertAstDepth = ast => {
+  const stack = [{ node: ast, depth: 0, index: 0 }];
+  const active = new Set();
+  let visits = 0;
+
+  while (stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    const node = frame.node;
+    if (frame.index === 0) {
+      if (!node || typeof node !== 'object') {
+        throw new TypeError('Expected an AST node');
+      }
+      if (++visits > 2 * MAX_LENGTH + 3) {
+        throw new SyntaxError('Braces AST exceeds local node visit limit (20003)');
+      }
+      if (active.has(node)) {
+        throw new SyntaxError('Cyclic braces AST is not supported');
+      }
+      exports.assertPrimitive(node.value, 'AST value');
+      exports.assertPrimitive(node.commas, 'AST commas');
+      exports.assertPrimitive(node.ranges, 'AST ranges');
+      if (node.nodes) {
+        if (!Array.isArray(node.nodes)) throw new TypeError('Expected AST nodes to be an array');
+        exports.checkDepth(frame.depth);
+      }
+      active.add(node);
+    }
+
+    if (node.nodes && frame.index < node.nodes.length) {
+      stack.push({ node: node.nodes[frame.index++], depth: frame.depth + 1, index: 0 });
+    } else {
+      active.delete(node);
+      stack.pop();
+    }
+  }
+};
